generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

// PAYSTACK is retained for historical rows only; every new payment is
// FLUTTERWAVE and the Paystack write paths have been removed.
enum PaymentProvider {
  PAYSTACK
  FLUTTERWAVE
}

enum PaymentType {
  PROGRAM
  CAMP
  CONSULTATION
}

enum ConsultationStatus {
  PENDING
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum CampStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

// Lifecycle for a single camp registration row.
// - PENDING_PAYMENT: created by /api/camps/:id/register; holds a seat for `paymentExpiresAt` (default 60 min).
// - CONFIRMED:       provider webhook reported success while still within the hold window.
// - EXPIRED:         hold elapsed without a successful charge; seat is released and the row is reusable on retry.
// - CANCELLED:       explicit void by admin/support; seat released. Distinct from EXPIRED for reporting.
enum CampRegistrationStatus {
  PENDING_PAYMENT
  CONFIRMED
  EXPIRED
  CANCELLED
}

// Blog listing filters (design: Reflection, Wellbeing, Personal Growth)
enum BlogCategory {
  REFLECTION
  WELLBEING
  PERSONAL_GROWTH
}

// Matches the "Type" field in the Add Module modal (Reading, Video, Quiz, etc.)
enum ModuleType {
  VIDEO
  READING
  QUIZ
  ASSIGNMENT
  OTHER
}

enum ChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ChatKnowledgeSourceType {
  PROGRAM
  CAMP
  CONSULTATION
  BLOG
  POLICY
  TESTIMONIAL
  COMMUNITY
}

// Short reusable keyword pills shown on programs, consultations and communities.
// TOPIC  — the "Popular Topics" chips (many per entity).
// FORMAT — a consultation's delivery format (exactly one per service, via FK).
// Tags are created on demand: passing an unknown name on create/update adds it
// to the shared vocabulary rather than erroring. See src/services/tag.service.ts.
enum TagType {
  TOPIC
  FORMAT
}

// Presentment currencies the platform can sell in. GBP is the base and the
// only currency prices are stored in. Rows are the capability list: seed only
// what Flutterwave can both collect and settle.
model SupportedCurrency {
  code      String   @id
  isBase    Boolean  @default(false)
  isEnabled Boolean  @default(true)
  marginBps Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("supported_currencies")
}

// Append-only. Payment rows reference a rate by id, so a row must never be
// updated in place — superseding writes supersededAt and inserts a new row.
model FxRate {
  id            String    @id @default(cuid())
  baseCurrency  String
  quoteCurrency String
  /// Quote units per 1 base unit.
  rate          Decimal   @db.Decimal(18, 8)
  source        String
  probeAmount   Decimal?  @db.Decimal(18, 2)
  fetchedAt     DateTime
  confirmedAt   DateTime?
  supersededAt  DateTime?
  createdAt     DateTime  @default(now())

  payments Payment[]

  @@index([quoteCurrency, supersededAt])
  @@index([quoteCurrency, fetchedAt])
  @@map("fx_rates")
}

model PlatformSettings {
  id                        String           @id @default("default")
  platformName              String           @default("Sit With PD")
  supportEmail              String           @default("support@sitwithpd.com")
  defaultTimezone           String           @default("Africa/Lagos")
  maintenanceMode           Boolean          @default(false)
  allowUserRegistration     Boolean          @default(true)
  requireEmailVerification  Boolean          @default(true)
  autoEnrollment            Boolean          @default(false)
  emailNotificationsEnabled Boolean          @default(true)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  @@map("platform_settings")
}

model User {
  id                      String    @id @default(cuid())
  firstName               String
  lastName                String
  email                   String    @unique
  password                String?
  googleId                String?   @unique
  role                    Role      @default(USER)
  isEmailVerified         Boolean   @default(false)
  emailVerificationToken  String?
  emailVerificationExpiry DateTime?
  passwordResetToken      String?
  passwordResetExpiry     DateTime?
  phone                   String?
  timezone                String?
  notifyEmail             Boolean   @default(true)
  notifyProgramReminders  Boolean   @default(false)
  notifyPush              Boolean   @default(true)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  purchases         Purchase[]
  campRegistrations CampRegistration[]
  consultations     Consultation[]
  payments          Payment[]
  programModuleCompletions ProgramModuleCompletion[]
  blogPosts         BlogPost[]
  chatSessions      ChatSession[]

  @@map("users")
}

// Matches the Program Type dropdown: Leaders, Students, Professionals
enum ProgramCategory {
  LEADERS
  STUDENTS
  PROFESSIONALS
}

model Program {
  id               String           @id @default(cuid())
  title            String
  description      String
  priceMinor       BigInt
  category         ProgramCategory  @default(LEADERS)
  thumbnail        String?
  isPublished      Boolean         @default(false)
  durationWeeks    Int?
  hoursPerWeek     Float?
  certificateLabel String?
  learningOutcomes String[] // Program-level learning objectives (Step 2 of form)
  audience         String[]
  videoLinks       String[]
  startDate        DateTime?
  facilitatorName  String?
  facilitatorEmail String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // Three-level hierarchy: Program → Week → Module
  weeks     ProgramWeek[]
  purchases Purchase[]
  tags      ProgramTag[]

  @@map("programs")
}

// Represents a "Week" in the Program Weeks section of the design.
// Each week has a title, description, its own learning objectives, and child modules.
model ProgramWeek {
  id                 String   @id @default(cuid())
  programId          String
  title              String
  description        String?
  learningObjectives String[] // Per-week learning objectives added via the modal
  order              Int // Determines "Week 1", "Week 2" display order

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  program Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  modules ProgramModule[]

  @@map("program_weeks")
}

// Represents a "Module" inside a week.
// Fields map directly to the "Add Module to Week" modal in the design.
model ProgramModule {
  id          String     @id @default(cuid())
  weekId      String
  title       String
  description String?
  type        ModuleType @default(OTHER)
  duration    String? // Free-text: "45 min", "1 hr", etc. (matches the design's Duration field)
  contentUrl  String? // YouTube, Vimeo, Google Docs URL (Content URL field)
  embedCode   String? // Raw iframe/HTML embed (Embed Code field)
  order       Int // Module display order within the week

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  week ProgramWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  completions ProgramModuleCompletion[]

  @@map("program_modules")
}

// Recorded when the frontend signals a module was finished (video end, quiz submit, etc.).
model ProgramModuleCompletion {
  id          String   @id @default(cuid())
  userId      String
  moduleId    String
  completedAt DateTime @default(now())

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  module ProgramModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([userId])
  @@index([moduleId])
  @@map("program_module_completions")
}

// Enrolment row; programCompletedAt mirrors "all modules completed" for dashboard Completed section.
model Purchase {
  id                String    @id @default(cuid())
  userId            String
  programId         String
  createdAt         DateTime  @default(now())
  programCompletedAt DateTime?

  user    User     @relation(fields: [userId], references: [id])
  program Program  @relation(fields: [programId], references: [id])
  payment Payment?

  @@unique([userId, programId])
  @@map("purchases")
}

model Camp {
  id          String     @id @default(cuid())
  title       String
  description String
  location    String
  /// Single free-text phrase (e.g. "Wellness Retreat"). Required by the API on
  /// create, but nullable here so pre-existing camp rows migrate without a backfill.
  category    String?
  capacity    Int // Total seats across all tiers (sum of registration.participantCount must not exceed this)
  startDate   DateTime
  endDate     DateTime
  thumbnail   String?
  benefits    String[] // "Why Attend" bullet list (e.g. "Pause and reconnect with yourself")
  status      CampStatus @default(UPCOMING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tiers         CampTier[]
  images        CampImage[]
  testimonials  Testimonial[]
  registrations CampRegistration[]

  @@map("camps")
}

// Participation packages (e.g. Individual $500, Couple $750, Family $1500).
model CampTier {
  id           String   @id @default(cuid())
  campId       String
  label        String // "Individual", "Couple", "Family", etc.
  description  String?
  priceMinor   BigInt
  inclusions   String[] // ["Accommodation", "Meals", "Guided sessions", ...]
  seatsPerUnit Int      @default(1) // 1 for Individual, 2 for Couple, 4-5 for Family — consumed from camp.capacity
  maxUnits     Int? // Optional cap on how many of this tier can be sold (null = only bound by camp capacity)
  order        Int      @default(0)
  isFeatured   Boolean  @default(false) // Design highlights the middle tier (Couple)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  camp          Camp               @relation(fields: [campId], references: [id], onDelete: Cascade)
  registrations CampRegistration[]

  @@unique([campId, label])
  @@map("camp_tiers")
}

// Gallery photos for the "A Glimpse Into the Experience" section.
model CampImage {
  id        String   @id @default(cuid())
  campId    String
  url       String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  camp Camp @relation(fields: [campId], references: [id], onDelete: Cascade)

  @@map("camp_images")
}

// Testimonials for camps (campId) or site-wide (campId = null).
model Testimonial {
  id          String   @id @default(cuid())
  campId      String?
  name        String
  role        String? // "Camp Participant", "Camp Attendee", "Program Student", etc.
  quote       String
  avatarUrl   String?
  isPublished Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  camp Camp? @relation(fields: [campId], references: [id], onDelete: SetNull)

  @@map("testimonials")
}

// Site "Our Team" section — managed by admins (name, role, photo).
model TeamMember {
  id          String   @id @default(cuid())
  name        String
  role        String
  photoUrl    String?
  isPublished Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("team_members")
}

model BlogPost {
  id                 String       @id @default(cuid())
  slug               String       @unique
  title              String
  excerpt            String
  body               String
  readTimeMinutes    Int          @default(5)
  category           BlogCategory
  coverImageUrl      String?
  isPublished        Boolean      @default(false)
  publishedAt        DateTime?
  authorId           String?
  /// Public byline when different from linked User (guest, posting on behalf of someone).
  authorDisplayName  String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([authorId])
  @@map("blog_posts")
}

model CampRegistration {
  id               String                 @id @default(cuid())
  userId           String
  campId           String
  tierId           String?
  participantCount Int                    @default(1) // Seats consumed (copied from tier.seatsPerUnit at creation)
  applicantDetails Json? // Dietary, emergency contact, partner/family names, accommodation prefs, etc.
  // Lifecycle: PENDING_PAYMENT (default on register) → CONFIRMED (webhook) | EXPIRED (worker) | CANCELLED (admin).
  // After EXPIRED, the user may retry the same camp; the row is reused (reset to PENDING_PAYMENT).
  status           CampRegistrationStatus @default(PENDING_PAYMENT)
  // Wall-clock deadline for completing payment while status = PENDING_PAYMENT (typically now + 60 min).
  // Null when status is no longer PENDING_PAYMENT.
  paymentExpiresAt DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  user         User              @relation(fields: [userId], references: [id])
  camp         Camp              @relation(fields: [campId], references: [id], onDelete: Cascade)
  tier         CampTier?         @relation(fields: [tierId], references: [id], onDelete: SetNull)
  payment      Payment?
  participants CampParticipant[]

  // Deliberately NOT unique on (userId, campId): a user may buy several units.
  // A new purchase is blocked while they hold an unexpired PENDING_PAYMENT row
  // or a PENDING payment — see canStartNewRegistration().
  @@index([userId, campId])
  // Inventory math (seatsTaken / per-tier units) filters by (campId, status).
  @@index([campId, status])
  // Expiry worker scans PENDING_PAYMENT rows whose paymentExpiresAt has elapsed.
  @@index([status, paymentExpiresAt])
  @@map("camp_registrations")
}

// One row per attendee, including the lead applicant. The manifest is the
// roster the organiser works from, so it is queryable rather than a JSON blob.
// participants.length must equal CampRegistration.participantCount.
model CampParticipant {
  id                    String   @id @default(cuid())
  registrationId        String
  fullName              String
  /// The account holder who booked; exactly one per registration.
  isLead                Boolean  @default(false)
  age                   Int?
  relationship          String?
  dietaryRequirements   String?
  medicalConditions     String?
  emergencyContactName  String?
  emergencyContactPhone String?
  order                 Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  registration CampRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId, order])
  @@map("camp_participants")
}

model ConsultationService {
  id             String           @id @default(cuid())
  title          String
  description    String
  priceMinor     BigInt
  duration       Int
  calEventTypeId Int?
  calBookingUrl  String?
  /// Hero image for the service card (Cloudinary URL).
  coverImageUrl  String?
  /// "Who's it for" — full-sentence bullets written per service (not tags).
  audience       String[]
  /// "What's included" — full-sentence bullets written per service (not tags).
  whatsIncluded  String[]
  /// Delivery format ("1-on-1 video call"). One per service, drawn from the
  /// shared FORMAT tag vocabulary so the admin dropdown stays consistent.
  formatTagId    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  consultations Consultation[]
  formatTag     Tag?                     @relation("ConsultationServiceFormat", fields: [formatTagId], references: [id], onDelete: SetNull)
  tags          ConsultationServiceTag[]

  @@unique([calEventTypeId])
  @@index([formatTagId])
  @@map("consultation_services")
}

// ── Tags (shared vocabulary) ──────────────────────────────────────────────────

model Tag {
  id        String   @id @default(cuid())
  /// Display text as first written, e.g. "Career Exploration".
  name      String
  /// Normalised dedupe key derived from `name`, e.g. "career-exploration".
  slug      String
  type      TagType  @default(TOPIC)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programs             ProgramTag[]
  consultationServices ConsultationServiceTag[]
  communities          CommunityTag[]
  formatForServices    ConsultationService[] @relation("ConsultationServiceFormat")

  // Scoped by type so "Wellness" can exist as both a TOPIC and a FORMAT.
  @@unique([type, slug])
  // Powers GET /api/tags?type=TOPIC (admin autocomplete), ordered by name.
  @@index([type, name])
  @@map("tags")
}

// Explicit join tables (rather than Prisma implicit m-n) so pill order is
// preserved and the reverse lookup index is explicit.
model ProgramTag {
  programId String
  tagId     String
  order     Int    @default(0)

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([programId, tagId])
  // The composite PK only indexes programId-first; this covers "programs tagged X".
  @@index([tagId])
  @@map("program_tags")
}

model ConsultationServiceTag {
  serviceId String
  tagId     String
  order     Int    @default(0)

  service ConsultationService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  tag     Tag                 @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([serviceId, tagId])
  @@index([tagId])
  @@map("consultation_service_tags")
}

model CommunityTag {
  communityId String
  tagId       String
  order       Int    @default(0)

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([communityId, tagId])
  @@index([tagId])
  @@map("community_tags")
}

// ── Communities (WhatsApp groups) ─────────────────────────────────────────────

model Community {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  subtitle     String
  description  String
  gains        String[]
  videoLinks   String[]
  /// Key into the frontend pd-icons map (e.g. "stewardship"). Not an image URL.
  iconKey      String?
  whatsappLink String
  isPublished  Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tags         CommunityTag[]
  joinRequests CommunityJoinRequest[]

  @@index([isPublished, order])
  @@map("communities")
}

// Anonymous join application. On successful submit the WhatsApp link is emailed
// immediately; admins view these as a record and can resend a failed delivery.
model CommunityJoinRequest {
  id             String    @id @default(cuid())
  communityId    String
  fullName       String
  email          String
  phone          String?
  reason         String?
  agreedToPolicy Boolean   @default(false)
  /// Null when the send failed — drives the admin "resend" action.
  linkEmailedAt  DateTime?
  emailError     String?
  source         String    @default("community_page")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  // Re-applying updates the existing row instead of re-blasting the link.
  @@unique([communityId, email])
  @@index([communityId, createdAt])
  @@index([email])
  @@map("community_join_requests")
}

model Consultation {
  id               String             @id @default(cuid())
  userId           String
  serviceId        String
  preferredDate    DateTime?
  confirmedDate    DateTime?
  notes            String?
  status           ConsultationStatus @default(PENDING)
  calBookingId     String?            @unique
  calBookingUrl    String?
  paymentExpiresAt DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user    User                @relation(fields: [userId], references: [id])
  service ConsultationService @relation(fields: [serviceId], references: [id])
  payment Payment?

  @@map("consultations")
}

model Payment {
  id                 String          @id @default(cuid())
  userId             String
  type               PaymentType
  status             PaymentStatus   @default(PENDING)
  provider           PaymentProvider @default(FLUTTERWAVE)
  /// Flutterwave tx_ref, generated by us and echoed back on webhook.
  providerRef        String          @unique
  providerResponse   Json?

  presentmentCurrency    String
  presentmentAmountMinor BigInt
  baseCurrency           String    @default("GBP")
  baseAmountMinor        BigInt
  fxRateId               String?
  fxRate                 Decimal?  @db.Decimal(18, 8)
  marginBps              Int       @default(0)
  quotedAt               DateTime  @default(now())
  /// Only knowable from the webhook — the card decides, not the checkout.
  settlementCurrency     String?

  purchaseId         String?         @unique
  campRegistrationId String?         @unique
  consultationId     String?         @unique
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  fxRateUsed       FxRate?           @relation(fields: [fxRateId], references: [id])
  user             User              @relation(fields: [userId], references: [id])
  purchase         Purchase?         @relation(fields: [purchaseId], references: [id])
  campRegistration CampRegistration? @relation(fields: [campRegistrationId], references: [id], onDelete: SetNull)
  consultation     Consultation?     @relation(fields: [consultationId], references: [id])

  @@map("payments")
}

// Footer / marketing list: stored locally and synced to Resend Audiences (contacts) when RESEND_API_KEY is set.
model NewsletterSubscription {
  id               String    @id @default(cuid())
  email            String    @unique
  unsubscribeToken String    @unique
  source           String    @default("footer")
  subscribedAt     DateTime  @default(now())
  unsubscribedAt   DateTime?
  resendContactId  String?
  resendSyncedAt   DateTime?
  resendLastError  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("newsletter_subscriptions")
}

// Public Contact Us page submissions (anonymous visitors).
model ContactSubmission {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  phone     String?
  message   String
  source    String   @default("contact_page")
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
  @@map("contact_submissions")
}

// ── AI Chat (OpenAI + pgvector RAG) ───────────────────────────────────────────

model ChatSession {
  id              String    @id @default(cuid())
  userId          String?
  /// SHA-256 hex of the guest cookie token (never store the raw token).
  guestTokenHash  String?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user     User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages ChatMessage[]
  usageLogs ChatUsageLog[]

  @@index([userId])
  @@index([guestTokenHash])
  @@index([expiresAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String          @id @default(cuid())
  sessionId String
  role      ChatMessageRole
  content   String
  metadata  Json?
  createdAt DateTime        @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

model ChatKnowledgeChunk {
  id          String                  @id @default(cuid())
  sourceType  ChatKnowledgeSourceType
  sourceId    String
  chunkIndex  Int                     @default(0)
  title       String
  path        String
  text        String
  contentHash String
  /// pgvector column — read/write via raw SQL ($executeRaw); Prisma cannot query vectors natively.
  embedding   Unsupported("vector(1536)")?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([sourceType, sourceId, chunkIndex])
  @@index([sourceType, sourceId])
  @@index([contentHash])
  @@map("chat_knowledge_chunks")
}

model ChatUsageLog {
  id               String   @id @default(cuid())
  sessionId        String?
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  estimatedCostUsd Float    @default(0)
  model            String
  createdAt        DateTime @default(now())

  session ChatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("chat_usage_logs")
}
